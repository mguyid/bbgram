# Set in Coolify → Environment Variables. Everything else is automatic:
#   - CORS is derived from MINIAPP_URL and ADMIN_URL.
#   - Telegram, X, chain, signer key and contract addresses are set in the admin dashboard (Settings page).

# Database (password required; any characters are fine).
POSTGRES_USER=babygrand
POSTGRES_PASSWORD=
POSTGRES_DB=babygrand
# Signs sessions and encrypts stored secrets (required). Never change it after launch.
JWT_SECRET=

# Public URLs of the three apps (must match the domains in Coolify → Domains).
# Leave empty to use the staging URLs baked into docker-compose.yml.
API_URL=
MINIAPP_URL=
ADMIN_URL=
# WalletConnect project id from dashboard.reown.com (build-time, public).
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Leave false in production.
DEV_MODE=false

# --- Contract deploy (Foundry scripts on a developer machine, not used by Coolify) ---
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=
TREASURY_ADDRESS=
TOKEN_NAME=Baby Grand
# Ticker without "$", e.g. BABYGRAM
TOKEN_SYMBOL=
