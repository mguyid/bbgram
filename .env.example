# Infrastructure only. Telegram, X, chain, signer key and contract addresses
# are runtime settings managed in the admin dashboard (Settings page).

# --- Core ---
POSTGRES_USER=babygrand
POSTGRES_PASSWORD=change-me
POSTGRES_DB=babygrand
DATABASE_URL=postgresql+asyncpg://babygrand:change-me@postgres:5432/babygrand
REDIS_URL=redis://redis:6379/0
# Signs sessions and encrypts stored secrets. Changing it means re-entering secrets in admin.
JWT_SECRET=change-me-long-random
DEV_MODE=false

# --- Public URLs ---
API_PUBLIC_URL=https://api.example.com
MINIAPP_URL=https://app.example.com
ADMIN_URL=https://admin.example.com
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# --- Frontends (build-time) ---
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- Contract deploy (Foundry scripts on a developer machine, not used by containers) ---
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=
TREASURY_ADDRESS=
TOKEN_NAME=Baby Grand
TOKEN_SYMBOL=
